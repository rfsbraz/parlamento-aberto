{"Assunto":"Moção de confiança ao Governo","AutoresGP":[null],"Convidados":null,"DataAgendamentoDebate":null,"DataAnuncio":null,"DataEntrada":"1977-12-06","DescTipo":"Moção","Eleitos":null,"IniciativasConjuntas":null,"Legislatura":"I","Numero":"1","Observacoes":null,"OrgaoExterior":null,"OutrosSubscritores":null,"Publicacao":[{"URLDiario":"https://debates.parlamento.pt/catalogo/r3/dar/01/01/02/017/1977-12-07/481?pgs=481-547&org=PLC","debateDtReu":null,"idAct":null,"idDeb":null,"idInt":null,"idPag":"843241","obs":"Publicação e Debate\n","pag":["481-547"],"pagFinalDiarioSupl":null,"pubLeg":"I","pubNr":"17","pubSL":"2","pubTipo":"DAR I série","pubTp":"D","pubdt":"1977-12-07","supl":null},{"URLDiario":"https://debates.parlamento.pt/catalogo/r3/dar/01/01/02/018/1977-12-09/551?pgs=551-653&org=PLC","debateDtReu":null,"idAct":null,"idDeb":null,"idInt":null,"idPag":"843242","obs":"Debate","pag":["551-653"],"pagFinalDiarioSupl":null,"pubLeg":"I","pubNr":"18","pubSL":"2","pubTipo":"DAR I série","pubTp":"D","pubdt":"1977-12-09","supl":null}],"PublicacaoDebate":null,"ResultadoVotacaoPontos":null,"Sessao":"2","Texto":null,"TextosAprovados":null,"Tipo":"MOC","TipoAutor":"Governo","VotacaoDebate":[{"ausencias":null,"data":"1977-12-07","descricao":"Nos termos e para os efeitos do disposto na alínea b) do n.º 1 do artigo 198.º da Constituição da República Portuguesa (versão de 1976) a não aprovação da uma moção de confiança implica a demissão do Governo. E segundo o n.º 3 do artigo supracitado, o Presidente da República dissolverá, obrigatoriamente, a Assembleia da República quando esta haja recusado a confiança do Governo (…). As moções de confiança podem ser aprovadas por maioria simples dos Deputados presentes.  Em conformidade com o artigo 151.º da Constituição da República Portuguesa (versão de 1976), a Assembleia da República tem o mínimo de 240 e o máximo de 250 Deputados.\n","detalhe":null,"id":"140058","publicacao":[{"URLDiario":"https://debates.parlamento.pt/catalogo/r3/dar/01/01/02/018/1977-12-09/647?pgs=647&org=PLC","debateDtReu":null,"idAct":null,"idDeb":null,"idInt":null,"idPag":"927619","obs":null,"pag":["647-647"],"pagFinalDiarioSupl":null,"pubLeg":"I","pubNr":"18","pubSL":"2","pubTipo":"DAR I série","pubTp":"D","pubdt":"1977-12-09","supl":null}],"resultado":"Rejeitado","reuniao":"18","tipoReuniao":null,"unanime":null}]}
